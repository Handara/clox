{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compile C Project",
            "command": "gcc",
            "args": [
                "-g",
                "${workspaceFolder}/*.c",
                "-o",
                "${workspaceFolder}/main.out"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles all .c files in the workspace into main.out"
        }
    ]
}